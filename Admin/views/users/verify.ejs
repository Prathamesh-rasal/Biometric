<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Enter Password</h1>
    <div class="col-6 offset-3">
        <form action="/verify/<%= id %>" method="POST" novalidate class="needs-validation">
            

            <div class="mb-3">
                <label for="password" class="form-label">Password : </label>
                <input type="password" name="password" placeholder="Enter password" class="form-control" id="password" required>
                <div class="invalid-feedback">
                    password should be valid
                </div>
            </div>

            <button class="btn btn-success">Next</button>

        </form>
    </div>
</div>