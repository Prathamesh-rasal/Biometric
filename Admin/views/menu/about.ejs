
<% layout("/layouts/boilerplate") %>

<div class="container py-4 py-md-5">

    <!-- Hero Section -->
    <div class="p-4 p-md-5 rounded-4 shadow-sm mb-4 text-white"
         style="background: linear-gradient(135deg, #172554, #2563eb);">

        <span class="badge rounded-pill bg-light text-primary mb-3 px-3 py-2">
            Admin Panel
        </span>

        <h1 class="fw-bold mb-3">
            About Biometric Attendance System
        </h1>

        <p class="mb-0 opacity-75" style="max-width: 750px; line-height: 1.8;">
            A smart and secure attendance management platform designed
            to simplify faculty attendance tracking using face recognition,
            location verification, and digital attendance records.
        </p>
    </div>

    <!-- Introduction -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">

            <h4 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                Project Overview
            </h4>

            <p class="text-secondary" style="line-height: 1.9;">
                The Biometric Attendance System is a web-based application
                developed to make attendance management easier, faster,
                and more organized. It helps administrators manage users,
                verify attendance, and maintain attendance records in a
                centralized system.
            </p>

            <p class="text-secondary mb-0" style="line-height: 1.9;">
                The system uses face recognition and geographical location
                validation to help verify attendance. Administrators can
                manage registered users, configure the campus location,
                view attendance summaries, and download individual
                attendance reports.
            </p>

        </div>
    </div>

    <!-- Features -->
    <h4 class="fw-bold mb-3">Key Features</h4>

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-primary bg-opacity-10
                                text-primary d-inline-flex p-3 mb-3">
                        <i class="bi bi-person-bounding-box fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Face Recognition</h5>
                    <p class="text-secondary mb-0">
                        Helps verify a registered user's identity
                        before attendance is recorded.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-success bg-opacity-10
                                text-success d-inline-flex p-3 mb-3">
                        <i class="bi bi-geo-alt fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Location Verification</h5>
                    <p class="text-secondary mb-0">
                        Checks the user's geographical location against
                        the configured campus location and radius.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-info bg-opacity-10
                                text-info d-inline-flex p-3 mb-3">
                        <i class="bi bi-clipboard-data fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Attendance Dashboard</h5>
                    <p class="text-secondary mb-0">
                        Displays attendance summaries and individual
                        user attendance status.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-warning bg-opacity-10
                                text-warning d-inline-flex p-3 mb-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Check-In & Check-Out</h5>
                    <p class="text-secondary mb-0">
                        Maintains check-in time, check-out time,
                        attendance status, and working duration.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-danger bg-opacity-10
                                text-danger d-inline-flex p-3 mb-3">
                        <i class="bi bi-file-earmark-arrow-down fs-3"></i>
                    </div>
                    <h5 class="fw-bold">Attendance Reports</h5>
                    <p class="text-secondary mb-0">
                        Supports downloading individual attendance
                        histories in Excel and PDF formats.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="rounded-3 bg-secondary bg-opacity-10
                                text-secondary d-inline-flex p-3 mb-3">
                        <i class="bi bi-people fs-3"></i>
                    </div>
                    <h5 class="fw-bold">User Management</h5>
                    <p class="text-secondary mb-0">
                        Enables administrators to register users and
                        manage their attendance information.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Technology Stack -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">

            <h4 class="fw-bold mb-3">
                <i class="bi bi-code-slash text-primary me-2"></i>
                Technology Stack
            </h4>

            <p class="text-secondary mb-3">
                Technologies used in developing the application.
            </p>

            <div class="d-flex flex-wrap gap-2">
                <span class="badge rounded-pill text-bg-dark px-3 py-2">Node.js</span>
                <span class="badge rounded-pill text-bg-dark px-3 py-2">Express.js</span>
                <span class="badge rounded-pill text-bg-success px-3 py-2">MongoDB</span>
                <span class="badge rounded-pill text-bg-warning px-3 py-2">JavaScript</span>
                <span class="badge rounded-pill text-bg-primary px-3 py-2">EJS</span>
                <span class="badge rounded-pill text-bg-primary px-3 py-2">Bootstrap</span>
                <span class="badge rounded-pill text-bg-secondary px-3 py-2">Python</span>
                <span class="badge rounded-pill text-bg-secondary px-3 py-2">OpenCV</span>
                <span class="badge rounded-pill text-bg-secondary px-3 py-2">face_recognition</span>
            </div>

        </div>
    </div>

    <!-- Admin Responsibilities -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">

            <h4 class="fw-bold mb-3">
                <i class="bi bi-shield-check text-success me-2"></i>
                Admin Responsibilities
            </h4>

            <ul class="text-secondary mb-0" style="line-height: 2;">
                <li>Register and manage users.</li>
                <li>Configure the campus location and allowed radius.</li>
                <li>Monitor daily attendance summaries.</li>
                <li>Review attendance records and working duration.</li>
                <li>Download individual attendance reports.</li>
                <li>Protect user information and attendance records.</li>
            </ul>

        </div>
    </div>

    <!-- Footer -->
    <div class="text-center py-4">
        <div class="mb-2">
            <i class="bi bi-fingerprint display-5 text-primary"></i>
        </div>

        <h5 class="fw-bold">Biometric Attendance System</h5>

        <p class="text-secondary small mb-1">
            Smart Attendance. Better Management. Reliable Records.
        </p>

        <p class="text-secondary small mb-0">
            Admin Panel &copy; <%= new Date().getFullYear() %>
        </p>
    </div>

</div>
