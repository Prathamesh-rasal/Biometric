
<% layout("/layouts/boilerplate") %>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-secondary mb-0">
                Welcome back, <%= admin.username %>!
            </p>
        </div>

        <span class="badge text-bg-primary rounded-pill px-3 py-2">
            <i class="bi bi-people-fill me-1"></i>
            Total Users: <%= totalUsers %>
        </span>
    </div>

    <!-- Attendance Summary -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-secondary small mb-2">Present Today</p>
                            <h2 class="fw-bold text-success mb-0">
                                <%= presentCount %>
                            </h2>
                        </div>
                        <div class="rounded-3 bg-success bg-opacity-10 p-3">
                            <i class="bi bi-person-check-fill text-success fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-secondary small mb-2">Absent Today</p>
                            <h2 class="fw-bold text-danger mb-0">
                                <%= absentCount %>
                            </h2>
                        </div>
                        <div class="rounded-3 bg-danger bg-opacity-10 p-3">
                            <i class="bi bi-person-x-fill text-danger fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-secondary small mb-2">Half-Day Today</p>
                            <h2 class="fw-bold text-warning mb-0">
                                <%= halfDayCount %>
                            </h2>
                        </div>
                        <div class="rounded-3 bg-warning bg-opacity-10 p-3">
                            <i class="bi bi-clock-history text-warning fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">User Attendance</h5>
                    <p class="text-secondary small mb-0">
                        View users and download their attendance history.
                    </p>
                </div>

                <span class="badge text-bg-light border rounded-pill px-3 py-2">
                    <%= users.length %> Users
                </span>
            </div>
        </div>

        <% if (users.length === 0) { %>

            <div class="p-4 text-center">
                <i class="bi bi-people text-secondary display-5"></i>
                <h6 class="fw-bold mt-3">No users found</h6>
                <p class="text-secondary mb-0">
                    Add users to view their attendance here.
                </p>
            </div>

        <% } else { %>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3 py-3">#</th>
                            <th class="py-3">User Details</th>
                            <th class="py-3">Department</th>
                            <th class="py-3">Today's Status</th>
                            <th class="text-center px-3 py-3">Download History</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% users.forEach((user, index) => {
                            const status = todayStatus[String(user._id)] || "Absent";
                        %>

                            <tr>
                                <td class="px-3 text-secondary">
                                    <%= index + 1 %>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        <%= user.username %>
                                    </div>
                                    <small class="text-secondary">
                                        <%= user.email || "No email" %>
                                    </small>
                                </td>

                                <td>
                                    <span class="text-secondary">
                                        <%= user.department || "—" %>
                                    </span>
                                </td>

                                <td>
                                    <% if (status === "Present") { %>
                                        <span class="badge rounded-pill text-bg-success">
                                            Present
                                        </span>
                                    <% } else if (status === "Late") { %>
                                        <span class="badge rounded-pill text-bg-info">
                                            Late
                                        </span>
                                    <% } else if (status === "Half-Day") { %>
                                        <span class="badge rounded-pill text-bg-warning">
                                            Half-Day
                                        </span>
                                    <% } else { %>
                                        <span class="badge rounded-pill text-bg-danger">
                                            Absent
                                        </span>
                                    <% } %>
                                </td>

                                <td class="text-center px-3">
                                    <div class="d-inline-flex gap-2 flex-wrap justify-content-center">

                                        <a
                                            href="/admin/users/<%= user._id %>/attendance.xlsx"
                                            class="btn btn-sm btn-outline-success"
                                            title="Download Excel history"
                                        >
                                            <i class="bi bi-file-earmark-excel"></i>
                                            Excel
                                        </a>

                                        <a
                                            href="/admin/users/<%= user._id %>/attendance.pdf"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Download PDF history"
                                        >
                                            <i class="bi bi-file-earmark-pdf"></i>
                                            PDF
                                        </a>

                                    </div>
                                </td>
                            </tr>

                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } %>

        <div class="card-footer bg-white border-0 p-3">
            <small class="text-secondary">
                <i class="bi bi-shield-check me-1"></i>
                Attendance reports are available for individual users.
            </small>
        </div>

    </div>
</div>
