

 
<% layout("/layouts/boilerplate") %>
<div class="container py-4">

    <!-- Welcome -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome back, <%= user.username %>!
            </p>
        </div>

        <a href="/markAttendance" class="btn btn-success mt-3 mt-md-0">
            <i class="bi bi-camera me-2"></i>Mark Attendance
        </a>
    </div>

    <!-- Profile -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">My Profile</h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted">Name</small>
                    <div class="fw-semibold"><%= user.username %></div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">Email</small>
                    <div class="fw-semibold"><%= user.email || "Not provided" %></div>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">Department</small>
                    <div class="fw-semibold"><%= user.department || "Not provided" %></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-success mb-2">
                        <i class="bi bi-calendar-check fs-3"></i>
                    </div>
                    <p class="text-muted small mb-1">Present Days</p>
                    <h3 class="fw-bold mb-0"><%= presentDays %></h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-warning mb-2">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <p class="text-muted small mb-1">Late Days</p>
                    <h3 class="fw-bold mb-0"><%= lateDays %></h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-danger mb-2">
                        <i class="bi bi-calendar-x fs-3"></i>
                    </div>
                    <p class="text-muted small mb-1">Absent Days</p>
                    <h3 class="fw-bold mb-0"><%= absentDays %></h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="text-primary mb-2">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <p class="text-muted small mb-1">Working Hours</p>
                    <h3 class="fw-bold mb-0">
                        <%= Math.floor(totalWorkingMinutes / 60) %>h
                        <%= totalWorkingMinutes % 60 %>m
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Today's Attendance -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Today's Attendance</h5>
                <span class="badge text-bg-light"><%= today %></span>
            </div>

            <% if (todayAttendance) { %>

                <div class="row g-3">
                    <div class="col-md-4">
                        <small class="text-muted">Check-in</small>
                        <h5 class="fw-semibold mt-1">
                            <%= todayAttendance.checkIn
                                ? new Date(todayAttendance.checkIn).toLocaleTimeString("en-IN", {
                                    timeZone: "Asia/Kolkata",
                                    hour: "2-digit",
                                    minute: "2-digit",
                                    hour12: true
                                })
                                : "--" %>
                        </h5>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Check-out</small>
                        <h5 class="fw-semibold mt-1">
                            <%= todayAttendance.checkOut
                                ? new Date(todayAttendance.checkOut).toLocaleTimeString("en-IN", {
                                    timeZone: "Asia/Kolkata",
                                    hour: "2-digit",
                                    minute: "2-digit",
                                    hour12: true
                                })
                                : "Not checked out" %>
                        </h5>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Status</small>
                        <div class="mt-2">
                            <span class="badge <%= todayAttendance.status === 'Present'
                                ? 'text-bg-success'
                                : todayAttendance.status === 'Late'
                                    ? 'text-bg-warning'
                                    : todayAttendance.status === 'Absent'
                                        ? 'text-bg-danger'
                                        : 'text-bg-info' %>">
                                <%= todayAttendance.status %>
                            </span>
                        </div>
                    </div>
                </div>

            <% } else { %>

                <div class="text-center py-4">
                    <i class="bi bi-calendar-event display-5 text-muted"></i>
                    <h6 class="mt-3">Attendance not marked yet</h6>
                    <p class="text-muted mb-3">
                        Mark your attendance to see today's details.
                    </p>
                    <a href="/markAttendance" class="btn btn-outline-success">
                        Mark Attendance
                    </a>
                </div>

            <% } %>
        </div>
    </div>

    <!-- Attendance History -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">My Attendance History</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Working Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (attendanceRecords.length > 0) { %>

                            <% attendanceRecords.forEach(record => { %>
                                <tr>
                                    <td><%= record.date %></td>

                                    <td>
                                        <%= record.checkIn
                                            ? new Date(record.checkIn).toLocaleTimeString("en-IN", {
                                                timeZone: "Asia/Kolkata",
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: true
                                            })
                                            : "--" %>
                                    </td>

                                    <td>
                                        <%= record.checkOut
                                            ? new Date(record.checkOut).toLocaleTimeString("en-IN", {
                                                timeZone: "Asia/Kolkata",
                                                hour: "2-digit",
                                                minute: "2-digit",
                                                hour12: true
                                            })
                                            : "--" %>
                                    </td>

                                    <td>
                                        <%= Math.floor((record.workingMinutes || 0) / 60) %>h
                                        <%= (record.workingMinutes || 0) % 60 %>m
                                    </td>

                                    <td>
                                        <span class="badge <%= record.status === 'Present'
                                            ? 'text-bg-success'
                                            : record.status === 'Late'
                                                ? 'text-bg-warning'
                                                : record.status === 'Absent'
                                                    ? 'text-bg-danger'
                                                    : 'text-bg-info' %>">
                                            <%= record.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No attendance records found.
                                </td>
                            </tr>

                        <% } %>
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mb-0">
                Half-day records: <%= halfDays %>
            </p>
        </div>
    </div>

</div>
